# PostgreSQL connection string (Neon, Supabase, Railway, Render all work)
# Example (Neon): postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/lastmile?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/lastmile"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# SMTP (any free tier: Gmail app password, Mailtrap, Brevo, Ethereal for dev)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Last-Mile Tracker <no-reply@lastmile.dev>"
